{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amaryllis-produtos-naturais",
  "main": "functions/api/[[path]].ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "amaryllisnaturais.com.br", "custom_domain": true },
    { "pattern": "www.amaryllisnaturais.com.br", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amaryllis-db",
      "database_id": "13f3d382-871b-4bad-bd0d-cfb5c48c3763"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
